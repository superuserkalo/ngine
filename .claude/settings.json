{
  "permissions": {
    "allow": [
      "Bash(cargo fmt --all)",
      "Bash(cargo fmt --all --check)",
      "Bash(cargo check --workspace --all-targets --locked)",
      "Bash(cargo clippy --workspace --all-targets --locked -- -D warnings)",
      "Bash(cargo test --workspace --locked)",
      "Bash(cargo tree)",
      "Bash(cargo deny check)",
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --staged)",
      "Bash(git log --oneline -10)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git push origin main)",
      "Bash(gh run list --limit 1)",
      "Bash(gh run watch *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/commit-loop.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
