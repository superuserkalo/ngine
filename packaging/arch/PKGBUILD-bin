# Maintainer: ngine contributors

pkgname=ngine-bin
_pkgname=ngine
pkgver=0.0.0
pkgrel=1
pkgdesc='A lightweight screen recorder and clipper with instant replay (release build)'
arch=('x86_64')
url='https://github.com/superuserkalo/ngine'
license=('MIT' 'LGPL-2.1-or-later' 'BSD-3-Clause' 'BSD-2-Clause')
depends=('gcc-libs' 'glibc' 'libdrm' 'libxkbcommon' 'pipewire' 'vulkan-icd-loader' 'wayland'
         'xdg-desktop-portal' 'xdg-utils' 'hicolor-icon-theme')
optdepends=(
  'xdg-desktop-portal-hyprland: screen capture on Hyprland and Omarchy'
  'xdg-desktop-portal-gnome: screen capture on GNOME'
  'xdg-desktop-portal-kde: screen capture on KDE Plasma'
  'libva-mesa-driver: hardware encoding on AMD graphics'
  'intel-media-driver: hardware encoding on Intel graphics'
  'nvidia-utils: hardware encoding on NVIDIA graphics'
  'libx11: X11 sessions'
)
provides=('ngine')
conflicts=('ngine')
install=ngine.install
options=('!debug' '!strip')
_appimage="$_pkgname-$pkgver-linux-x86_64.AppImage"
source=("$_appimage::$url/releases/download/v$pkgver/$_appimage")
noextract=("$_appimage")
sha256sums=('SKIP')

prepare() {
  rm -rf squashfs-root
  chmod +x "$_appimage"
  "./$_appimage" --appimage-extract >/dev/null
}

package() {
  local app=squashfs-root/usr
  install -d "$pkgdir/usr/lib/ngine/bin" "$pkgdir/usr/lib/ngine/lib" "$pkgdir/usr/bin"
  install -m 755 "$app/bin/ngine" "$pkgdir/usr/lib/ngine/bin/ngine"
  cp -P "$app"/lib/*.so* "$pkgdir/usr/lib/ngine/lib/"
  ln -s /usr/lib/ngine/bin/ngine "$pkgdir/usr/bin/ngine"
  cp -R "$app/share" "$pkgdir/usr/"
}
